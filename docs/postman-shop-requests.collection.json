{
  "info": {
    "name": "Bahibo Shop Requests",
    "description": "Collection Postman pour tester la demande de creation de boutique et les endpoints admin de validation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://10.44.12.62:4000/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "User - Submit Shop Request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/profiles/me/shop-request",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "profiles",
            "me",
            "shop-request"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Admin - List Pending Shop Requests",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/profiles/admin/shop-requests/pending",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "profiles",
            "admin",
            "shop-requests",
            "pending"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Admin - Approve Shop Request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/profiles/admin/shop-requests/{{userId}}/approve",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "profiles",
            "admin",
            "shop-requests",
            "{{userId}}",
            "approve"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Auth - Current User",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        }
      },
      "response": []
    }
  ]
}