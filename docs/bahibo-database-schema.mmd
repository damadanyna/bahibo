    USERS {
        uuid id PK
        string phone_e164
        string display_name
        string avatar_url
        string cover_image_url
        string preferred_language
        string role
        boolean is_verified
        datetime created_at
        datetime updated_at
    }

    USER_SESSIONS {
        uuid id PK
        uuid user_id FK
        string access_token_hash
        string refresh_token_hash
        datetime expires_at
        datetime created_at
    }

    SELLER_PROFILES {
        uuid id PK
        uuid user_id FK
        string studio_name
        string address_text
        string city
        string country
        text description
        decimal rating_avg
        int follower_count_cache
        int visitor_count_cache
        boolean is_certified
        datetime created_at
        datetime updated_at
    }

    CATEGORIES {
        uuid id PK
        uuid parent_id FK
        string slug UK
        string name
        string icon
        boolean is_active
    }

    PRODUCTS {
        uuid id PK
        uuid seller_profile_id FK
        uuid category_id FK
        string title
        text description
        decimal price_amount
        string currency_code
        string condition_label
        string status_label
        string city
        boolean is_available
        boolean is_verified
        datetime published_at
        datetime created_at
        datetime updated_at
    }

    PRODUCT_IMAGES {
        uuid id PK
        uuid product_id FK
        string image_url
        int sort_order
        boolean is_primary
    }

    PRODUCT_LIKES {
        uuid product_id FK
        uuid user_id FK
        datetime created_at
    }

    PRODUCT_COMMENTS {
        uuid id PK
        uuid product_id FK
        uuid author_user_id FK
        text body
        datetime created_at
        datetime updated_at
    }

    COMMENT_ATTACHMENTS {
        uuid id PK
        uuid comment_id FK
        uuid uploaded_by_user_id FK
        string attachment_type
        string file_name
        string file_url
        string mime_type
        int file_size_bytes
        datetime created_at
    }

    CONVERSATIONS {
        uuid id PK
        uuid product_id FK
        string conversation_type
        datetime created_at
        datetime last_message_at
    }

    CONVERSATION_PARTICIPANTS {
        uuid conversation_id FK
        uuid user_id FK
        datetime joined_at
        datetime last_read_at
        boolean is_muted
    }

    CHAT_MESSAGES {
        uuid id PK
        uuid conversation_id FK
        uuid sender_user_id FK
        text body
        string message_type
        string delivery_status
        datetime created_at
    }

    MESSAGE_ATTACHMENTS {
        uuid id PK
        uuid message_id FK
        string attachment_type
        string file_name
        string file_url
        string mime_type
        int file_size_bytes
        datetime created_at
    }

    SELLER_FOLLOWERS {
        uuid seller_profile_id FK
        uuid follower_user_id FK
        datetime created_at
    }

    LIVE_SESSIONS {
        uuid id PK
        uuid seller_profile_id FK
        uuid category_id FK
        string title
        string status
        datetime started_at
        datetime ended_at
    }

    LIVE_COMMENTS {
        uuid id PK
        uuid live_session_id FK
        uuid author_user_id FK
        text body
        datetime created_at
    }

    LIVE_REACTIONS {
        uuid id PK
        uuid live_session_id FK
        uuid author_user_id FK
        string emoji_code
        datetime created_at
    }

    SELLER_METRICS_DAILY {
        uuid id PK
        uuid seller_profile_id FK
        date metric_date
        int profile_views
        int likes_count
        int followers_gained
        int products_added
        decimal sales_amount
        int orders_count
    }

    PRODUCT_VIEWS {
        uuid id PK
        uuid product_id FK
        uuid viewer_user_id FK
        string source
        datetime viewed_at
    }

    ORDERS {
        uuid id PK
        uuid buyer_user_id FK
        uuid seller_profile_id FK
        string status
        decimal subtotal_amount
        decimal delivery_amount
        decimal total_amount
        string currency_code
        datetime created_at
    }

    ORDER_ITEMS {
        uuid id PK
        uuid order_id FK
        uuid product_id FK
        int quantity
        decimal unit_price_amount
        decimal total_price_amount
    }

    TAGS {
        uuid id PK
        string name UK
    }

    PRODUCT_TAGS {
        uuid product_id FK
        uuid tag_id FK
    }