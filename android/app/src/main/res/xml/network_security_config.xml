<?xml version="1.0" encoding="utf-8"?>
<!--
  Production: cleartext blocked globally (base-config).
  Development: cleartext allowed only for known local dev hosts (domain-config).
  This replaces android:usesCleartextTraffic="true" in AndroidManifest.xml.
-->
<network-security-config>

    <!-- Block cleartext for all hosts by default (production-safe). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <!--
      Allow plain HTTP only for known development hosts.
      These are never reachable in production (private LAN / emulator IP ranges).
        10.0.2.2  — Android Emulator host
        10.0.3.2  — Genymotion host
        192.168.245.62 — known dev LAN IP (ApiConfig._knownDevHost)
        localhost / 127.0.0.1 — local loopback
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">192.168.245.62</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

</network-security-config>
