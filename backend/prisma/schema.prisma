generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}

enum ShopRequestStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  READY
  IN_TRANSIT
  DELIVERED
  FAILED
}

enum ChatConversationKind {
  DIRECT
  PRODUCT
}

model User {
  id              String         @id @default(uuid())
  phoneE164       String         @unique
  countryName     String?
  countryDialCode String?
  displayName     String
  displayNameChangedAt DateTime?
  passwordHash    String
  avatarUrl       String?
  coverImageUrl   String?
  lastSeenAt      DateTime?
  locationLabel   String?
  locationLatitude Float?
  locationLongitude Float?
  locationUpdatedAt DateTime?
  preferredLanguage String?
  role            UserRole       @default(CUSTOMER)
  shopRequestStatus ShopRequestStatus @default(NONE)
  shopRequestSubmittedAt DateTime?
  shopRequestReviewedAt DateTime?
  isVerified      Boolean        @default(false)
  isSellerCertified Boolean      @default(false)
  sellerVerificationRequestStatus ShopRequestStatus @default(NONE)
  sellerVerificationRequestedAt DateTime?
  sellerVerificationReviewedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  refreshTokens   RefreshToken[]
  sellerProfile   SellerProfile?
  cart            Cart?
  orders          Order[]
  boughtConversations ChatConversation[] @relation("ConversationBuyer")
  soldConversations   ChatConversation[] @relation("ConversationSeller")
  chatMessages        ChatMessage[]      @relation("MessageSender")
  deviceTokens        UserDeviceToken[]
  notificationReadStates NotificationReadState[]
  searchHistories     SearchHistory[]
  sellerFollows       SellerFollow[]     @relation("SellerFollowFollower")
  sellerProfileViews  SellerProfileView[] @relation("SellerProfileViewViewer")
  productLikes        ProductLike[]
  productComments     ProductComment[]
  productCommentMentions ProductCommentMention[]
  productShares       ProductShare[]
  reportsSent         UserReport[]       @relation("UserReportsSent")
  reportsReceived     UserReport[]       @relation("UserReportsReceived")
  blocksSent          UserBlock[]        @relation("UserBlocksSent")
  blocksReceived      UserBlock[]        @relation("UserBlocksReceived")
}

model UserBlock {
  id            String   @id @default(uuid())
  blockerUserId String
  blockedUserId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  blocker       User     @relation("UserBlocksSent", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked       User     @relation("UserBlocksReceived", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerUserId, blockedUserId])
  @@index([blockerUserId, createdAt])
  @@index([blockedUserId, createdAt])
}

model UserReport {
  id             String   @id @default(uuid())
  reporterUserId String
  reportedUserId String
  conversationId String?
  reason         String?
  details        String?
  blockRequested Boolean  @default(false)
  createdAt      DateTime @default(now())
  reporter       User     @relation("UserReportsSent", fields: [reporterUserId], references: [id], onDelete: Cascade)
  reported       User     @relation("UserReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([reporterUserId, createdAt])
  @@index([reportedUserId, createdAt])
  @@index([conversationId, createdAt])
}

model SearchHistory {
  id              String   @id @default(uuid())
  userId          String
  query           String
  normalizedQuery String
  resultCount     Int      @default(0)
  occurrenceCount Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastSearchedAt  DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedQuery])
  @@index([userId, resultCount, lastSearchedAt])
}

model NotificationReadState {
  id             String   @id @default(uuid())
  notificationId String
  userId         String
  readAt         DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId, readAt])
}

model UserDeviceToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt])
}

model PhoneOtpChallenge {
  id              String   @id @default(uuid())
  phoneE164       String
  countryName     String?
  countryDialCode String?
  codeHash        String
  expiresAt       DateTime
  attempts        Int      @default(0)
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([phoneE164, createdAt])
}

model RefreshToken {
  id         String   @id @default(uuid())
  tokenHash  String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SellerProfile {
  id          String    @id @default(uuid())
  studioName  String
  description String?
  city        String?
  country     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products    Product[]
  orders      Order[]
  followers   SellerFollow[]
  profileViews SellerProfileView[]
  liveSession SellerLiveSession?
}

model SellerLiveSession {
  id              String        @id @default(uuid())
  sellerProfileId String        @unique
  title           String
  category        String
  startedAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  endedAt         DateTime?
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@index([startedAt])
  @@index([endedAt])
}

model Category {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  icon      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id              String      @id @default(uuid())
  title           String
  description     String
  imageUrl        String
  priceAmount     Decimal     @db.Decimal(12, 2)
  currencyCode    String      @default("MGA")
  isAvailable     Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  sellerProfileId String
  categoryId      String
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  productImages   ProductImage[]
  likes           ProductLike[]
  comments        ProductComment[]
  shares          ProductShare[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  conversations   ChatConversation[]
}

model SellerFollow {
  id              String        @id @default(uuid())
  createdAt       DateTime      @default(now())
  followerUserId  String
  sellerProfileId String
  follower        User          @relation("SellerFollowFollower", fields: [followerUserId], references: [id], onDelete: Cascade)
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@unique([followerUserId, sellerProfileId])
  @@index([sellerProfileId, createdAt])
}

model SellerProfileView {
  id              String        @id @default(uuid())
  createdAt       DateTime      @default(now())
  viewerUserId    String?
  sellerProfileId String
  viewer          User?         @relation("SellerProfileViewViewer", fields: [viewerUserId], references: [id], onDelete: SetNull)
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@index([sellerProfileId, createdAt])
  @@index([viewerUserId, createdAt])
}

model ProductLike {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, createdAt])
}

model ProductComment {
  id              String   @id @default(uuid())
  content         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userId          String
  productId       String
  parentCommentId String?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  parentComment   ProductComment? @relation("ProductCommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         ProductComment[] @relation("ProductCommentReplies")
  mentions        ProductCommentMention[]

  @@index([productId, createdAt])
  @@index([productId, parentCommentId, createdAt])
  @@index([userId, createdAt])
  @@index([parentCommentId, createdAt])
}

model ProductCommentMention {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  commentId       String
  mentionedUserId String
  comment         ProductComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser   User     @relation(fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([commentId, mentionedUserId])
  @@index([mentionedUserId, createdAt])
}

model ProductShare {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([userId, createdAt])
}

model ProductImage {
  id        String   @id @default(uuid())
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ChatConversation {
  id            String        @id @default(uuid())
  buyerUserId   String
  sellerUserId  String
  productId     String?
  kind          ChatConversationKind @default(PRODUCT)
  directKey     String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lastMessageAt DateTime      @default(now())
  buyer         User          @relation("ConversationBuyer", fields: [buyerUserId], references: [id], onDelete: Cascade)
  seller        User          @relation("ConversationSeller", fields: [sellerUserId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  messages      ChatMessage[]

  @@unique([buyerUserId, sellerUserId, productId])
  @@index([buyerUserId, lastMessageAt])
  @@index([sellerUserId, lastMessageAt])
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  senderUserId   String
  content        String
  replyToMessageId String?
  replyToSenderUserId String?
  replyToSenderName String?
  replyToContent String?
  productId      String?
  productTitle   String?
  productSubtitle String?
  productPriceLabel String?
  productImageUrl String?
  createdAt      DateTime         @default(now())
  readAt         DateTime?
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User             @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([productId])
}

model Cart {
  id        String     @id @default(uuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id          String   @id @default(uuid())
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cartId      String
  productId   String
  cart        Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model Order {
  id               String        @id @default(uuid())
  orderNumber      String        @unique
  status           OrderStatus   @default(PENDING)
  subtotalAmount   Decimal       @db.Decimal(12, 2)
  deliveryAmount   Decimal       @db.Decimal(12, 2)
  totalAmount      Decimal       @db.Decimal(12, 2)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  buyerUserId      String
  sellerProfileId  String
  buyer            User          @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  sellerProfile    SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  items            OrderItem[]
  shipment         Shipment?
}

model OrderItem {
  id               String   @id @default(uuid())
  quantity         Int
  unitPriceAmount  Decimal  @db.Decimal(12, 2)
  totalPriceAmount Decimal  @db.Decimal(12, 2)
  orderId          String
  productId        String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Shipment {
  id             String         @id @default(uuid())
  carrierName    String?
  trackingNumber String?        @unique
  shipmentStatus ShipmentStatus @default(PENDING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  orderId        String         @unique
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
}